@page
@using SentimentAnalysis.Models
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div>
    <h1 class="display-4">Sentiment Analysis</h1>
    <table>
    <thead>
    <tr></tr>
    <th>Review Text</th>
    </tr>
    </thead>
    <tbody>
    @foreach(Review review in Model.reviewsToDisplay)
    {
        <tr>
        <td>@review.ReviewText</td>
        </tr>            
    }
    </tbody>
    </table>
</div>
